<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Performance Test Report</title>
<style>
  :root {
    --bg: #0f0f1a; --card: #181828; --card2: #1e1e30;
    --border: #2a2a40; --border2: #333348;
    --text: #e0e0f0; --muted: #8888aa;
    --blue: #388bfd; --green: #3fb950; --amber: #d29922;
    --red: #f85149; --purple: #bc8cff; --teal: #39d353;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: var(--bg); color: var(--text);
    font-size: 13px; line-height: 1.6;
  }

  .page { max-width: 1100px; margin: 0 auto; padding: 32px 28px; }

  /* ── Header ── */
  .report-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 18px 22px; margin-bottom: 28px;
  }
  .report-header .title-block p.eyebrow {
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--muted); margin-bottom: 4px;
  }
  .report-header .title-block h1 { font-size: 20px; font-weight: 600; color: var(--text); }
  .report-header .title-block p.sub { font-size: 12px; color: var(--muted); margin-top: 3px; }
  .verdict-badge {
    display: inline-block; padding: 5px 20px; border-radius: 20px;
    font-size: 13px; font-weight: 700; letter-spacing: 2px; margin-top: 4px;
  }
  .verdict-PASS    { background: #14532d; color: #4ade80; border: 1px solid #4ade80; }
  .verdict-FAIL    { background: #450a0a; color: #f87171; border: 1px solid #f87171; }
  .verdict-UNKNOWN { background: #1f2937; color: #9ca3af; border: 1px solid #4b5563; }

  /* ── Section ── */
  .section { margin-bottom: 28px; }
  .section-title {
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 6px 12px;
    background: var(--card); border-left: 3px solid;
    border-radius: 0 6px 6px 0; margin-bottom: 14px;
  }
  .section-title.blue   { border-color: var(--blue);   color: var(--blue); }
  .section-title.green  { border-color: var(--green);  color: var(--green); }
  .section-title.amber  { border-color: var(--amber);  color: var(--amber); }
  .section-title.red    { border-color: var(--red);    color: var(--red); }
  .section-title.purple { border-color: var(--purple); color: var(--purple); }
  .section-title.teal   { border-color: var(--teal);   color: var(--teal); }

  hr.divider { border: none; border-top: 1px solid var(--border); margin: 24px 0; }

  /* ── Metric cards ── */
  .metric-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px; margin-bottom: 12px;
  }
  .m-card { background: var(--card2); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; }
  .m-card .lbl { font-size: 10px; color: var(--muted); text-transform: uppercase;
                 letter-spacing: 0.05em; margin-bottom: 3px; }
  .m-card .val { font-size: 20px; font-weight: 700; }
  .val.ok   { color: #4ade80; }
  .val.warn { color: #fbbf24; }
  .val.crit { color: #f87171; }
  .val.info { color: #60a5fa; }

  /* ── Tables ── */
  .data-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .data-table thead th {
    background: #111; color: var(--muted); font-size: 10px;
    text-transform: uppercase; letter-spacing: 0.05em;
    padding: 8px 12px; text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .data-table tbody td {
    padding: 7px 12px; border-bottom: 1px solid var(--border2);
    vertical-align: middle; color: var(--text);
  }
  .data-table tbody tr:last-child td { border-bottom: none; }
  .data-table tbody tr:hover td { background: var(--card2); }
  .data-table tbody tr.crit td:first-child { border-left: 3px solid #ef4444; }
  .data-table tbody tr.warn td:first-child { border-left: 3px solid #f59e0b; }
  .data-table tbody tr.crit td { color: #fca5a5; }
  .data-table tbody tr.warn td { color: #fde68a; }
  .table-wrap {
    border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
    margin-bottom: 16px;
  }

  /* ── Badges ── */
  .badge {
    display: inline-block; padding: 2px 9px; border-radius: 10px;
    font-size: 10px; font-weight: 600;
  }
  .badge.ok   { background: #14532d; color: #4ade80; }
  .badge.warn { background: #451a03; color: #fbbf24; }
  .badge.crit { background: #450a0a; color: #f87171; }
  .badge.info { background: #1e3a5f; color: #60a5fa; }

  /* ── Bar rows ── */
  .bar-row { display: flex; align-items: center; gap: 10px; font-size: 12px; margin-bottom: 5px; }
  .bar-label { width: 130px; color: var(--muted); flex-shrink: 0; }
  .bar-track { flex: 1; height: 7px; background: var(--border); border-radius: 4px; overflow: hidden; }
  .bar-fill  { height: 100%; border-radius: 4px; }
  .bar-fill.ok   { background: #22c55e; }
  .bar-fill.warn { background: #f59e0b; }
  .bar-fill.crit { background: #ef4444; }
  .bar-val { width: 46px; text-align: right; font-weight: 600; flex-shrink: 0; }

  /* ── Server blocks ── */
  .server-block {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px 18px; margin-bottom: 14px;
  }
  .server-header {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
    padding-bottom: 12px; margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .server-name { font-weight: 600; font-size: 14px; color: var(--text); display: flex; align-items: center; gap: 8px; }
  .tag {
    display: inline-block; padding: 1px 8px; border-radius: 4px;
    font-size: 10px; background: var(--card2); color: var(--muted);
    border: 1px solid var(--border); margin-left: 6px;
  }
  .status-row { display: flex; gap: 8px; }
  .server-section-title {
    font-size: 10px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--muted); margin-bottom: 8px;
  }
  .server-divider { border: none; border-top: 1px solid var(--border2); margin: 14px 0; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  /* ── Finding rows ── */
  .findings-area { margin-top: 12px; border-top: 1px solid var(--border2); padding-top: 10px; }
  .finding-healthy {
    display: flex; align-items: center; gap: 7px;
    font-size: 11px; color: #4ade80;
  }
  .finding-callout {
    display: flex; align-items: flex-start; gap: 10px;
    border-radius: 6px; padding: 8px 12px; margin-bottom: 6px; font-size: 12px;
  }
  .finding-callout:last-child { margin-bottom: 0; }
  .finding-callout.crit { background: #2d0a0a; border-left: 3px solid #ef4444; color: #fca5a5; }
  .finding-callout.warn { background: #2d1a00; border-left: 3px solid #f59e0b; color: #fde68a; }
  .finding-callout-icon { font-size: 13px; flex-shrink: 0; margin-top: 1px; }

  /* ── Summary box ── */
  .summary-box {
    background: var(--card); border-left: 3px solid var(--amber);
    border-radius: 0 8px 8px 0; padding: 14px 18px;
    font-size: 13px; line-height: 1.7; color: var(--text); margin-bottom: 16px;
  }

  /* ── Chain ── */
  .chain { list-style: none; }
  .chain li { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
  .chain-num {
    background: var(--purple); color: #fff; border-radius: 50%;
    width: 22px; height: 22px; min-width: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 800;
  }
  .chain-txt {
    background: #1a0d2e; border: 1px solid #3a1060;
    border-radius: 6px; padding: 7px 12px; flex: 1; line-height: 1.5; color: var(--text);
  }

  /* ── Hypotheses ── */
  .hyp-card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; margin-bottom: 10px; }
  .hyp-card.r1 { border-left: 3px solid #ef4444; }
  .hyp-card.r2 { border-left: 3px solid #f59e0b; }
  .hyp-card.r3 { border-left: 3px solid #60a5fa; }
  .hyp-header  { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .hyp-rank    { border-radius: 50%; width: 22px; height: 22px; min-width: 22px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; }
  .r1 .hyp-rank { background: #450a0a; color: #f87171; }
  .r2 .hyp-rank { background: #451a03; color: #fbbf24; }
  .r3 .hyp-rank { background: #1e3a5f; color: #60a5fa; }
  .hyp-text { font-weight: 600; flex: 1; font-size: 13px; color: var(--text); }
  .conf-badge  { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: 10px; font-weight: 600; }
  .conf-High   { background: #450a0a; color: #f87171; }
  .conf-Medium { background: #451a03; color: #fbbf24; }
  .conf-Low    { background: #1e3a5f; color: #60a5fa; }
  .hyp-evidence { font-size: 11px; color: var(--muted); margin-top: 4px; }

  /* ── Timeline ── */
  .tl-item { display: flex; gap: 12px; margin-bottom: 8px; align-items: flex-start; }
  .tl-dot  { width: 9px; height: 9px; border-radius: 50%; margin-top: 4px; min-width: 9px; }
  .tl-dot.critical { background: #ef4444; }
  .tl-dot.warn     { background: #f59e0b; }
  .tl-dot.info     { background: #60a5fa; }
  .tl-ts  { font-size: 11px; color: var(--muted); min-width: 175px; }
  .tl-src { display: inline-block; background: var(--card2); border: 1px solid var(--border); border-radius: 3px; padding: 1px 6px; font-size: 9px; color: var(--muted); margin-right: 5px; vertical-align: middle; }
  .tl-desc { font-size: 12px; line-height: 1.5; }

  /* ── Footer ── */
  .footer { text-align: center; color: var(--muted); font-size: 10px; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--border); }
</style>
</head>
<body>
<div class="page">

<!-- ══ HEADER ══ -->
<div class="report-header">
  <div class="title-block">
    <p class="eyebrow">Performance test report — AI log mining</p>
    <h1>{% if lr_summary %}{{ lr_summary.test_name }}{% else %}{{ company_name }}{% endif %}</h1>
    <p class="sub">
      Run ID: {{ run_id }} &nbsp;·&nbsp; Generated: {{ generated_at }}
      {% if duration_min %} &nbsp;·&nbsp; Duration: {{ duration_min }} min{% endif %}
    </p>
  </div>
  <div style="text-align:right">
    <div class="verdict-badge verdict-{{ verdict }}">Verdict: {{ verdict }}</div>
    <p style="font-size:11px;color:var(--muted);margin-top:6px">
      {{ finding_counts.total }} findings
      {% if lr_summary and lr_summary.total_failed > 0 %}
        &nbsp;·&nbsp; <span style="color:var(--red)">{{ lr_summary.total_failed }} failed TXs</span>
      {% else %}
        &nbsp;·&nbsp; {{ finding_counts.threshold }} SLA breaches
      {% endif %}
    </p>
  </div>
</div>

{% macro render_findings(findings) %}
<div class="findings-area">
  {% set issues = findings | selectattr("sev", "ne", "ok") | list %}
  {% if issues %}
    {% for f in issues %}
    <div class="finding-callout {{ f.sev }}">
      <span class="finding-callout-icon">{% if f.sev == "crit" %}&#9888;{% else %}&#9654;{% endif %}</span>
      <span>{{ f.text }}</span>
    </div>
    {% endfor %}
  {% else %}
  <div class="finding-healthy">
    <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="#4ade80" stroke-width="1.5"/><path d="M5 8l2.2 2.4L11 5.5" stroke="#4ade80" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    All metrics within normal range
  </div>
  {% endif %}
</div>
{% endmacro %}

<!-- ══ TEST SUMMARY ══ -->
<div class="section">
  <div class="section-title blue">① Test summary</div>

  {% if lr_summary %}
  <!-- LR performance KPIs -->
  <div class="metric-grid">
    {% if lr_summary.target_tps %}
    <div class="m-card">
      <div class="lbl">Target TPS</div>
      <div class="val ok">{{ lr_summary.target_tps }}</div>
    </div>
    {% endif %}
    {% if lr_summary.achieved_tps is not none %}
    <div class="m-card">
      <div class="lbl">Achieved TPS</div>
      <div class="val {{ lr_summary.tps_sev }}">{{ lr_summary.achieved_tps }}</div>
    </div>
    {% endif %}
    {% if lr_summary.avg_resp is not none %}
    <div class="m-card">
      <div class="lbl">Avg Response</div>
      <div class="val {{ lr_summary.avg_sev }}">{{ lr_summary.avg_resp }}s</div>
    </div>
    {% endif %}
    {% if lr_summary.p90_resp is not none %}
    <div class="m-card">
      <div class="lbl">{{ lr_summary.sla_label }} Response</div>
      <div class="val {{ lr_summary.p90_sev }}">{{ lr_summary.p90_resp }}s</div>
    </div>
    {% endif %}
    {% if lr_summary.p99_resp is not none %}
    <div class="m-card">
      <div class="lbl">P99 Response</div>
      <div class="val {{ lr_summary.p99_sev }}">{{ lr_summary.p99_resp }}s</div>
    </div>
    {% endif %}
    <div class="m-card">
      <div class="lbl">Failed TXs</div>
      <div class="val {{ lr_summary.fail_sev }}">{{ lr_summary.total_failed }}</div>
    </div>
  </div>
  {% else %}
  <!-- Fallback: generic findings summary when no LR data -->
  <div class="metric-grid">
    <div class="m-card">
      <div class="lbl">Total findings</div>
      <div class="val {% if finding_counts.total > 20 %}crit{% elif finding_counts.total > 5 %}warn{% else %}ok{% endif %}">
        {{ finding_counts.total }}
      </div>
    </div>
    <div class="m-card">
      <div class="lbl">SLA breaches</div>
      <div class="val {% if finding_counts.threshold > 0 %}crit{% else %}ok{% endif %}">
        {{ finding_counts.threshold }}
      </div>
    </div>
    <div class="m-card">
      <div class="lbl">Anomalies</div>
      <div class="val {% if finding_counts.anomaly > 10 %}warn{% else %}info{% endif %}">
        {{ finding_counts.anomaly }}
      </div>
    </div>
    <div class="m-card">
      <div class="lbl">Trends</div>
      <div class="val {% if finding_counts.trend > 0 %}warn{% else %}ok{% endif %}">
        {{ finding_counts.trend }}
      </div>
    </div>
    <div class="m-card">
      <div class="lbl">Patterns</div>
      <div class="val {% if finding_counts.pattern > 0 %}warn{% else %}ok{% endif %}">
        {{ finding_counts.pattern }}
      </div>
    </div>
  </div>
  {% endif %}
</div>

<!-- ══ LR TRANSACTION RESULTS ══ -->
{% if lr_rows %}
<div class="section">
  <div class="section-title green">② LR transaction summary</div>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Transaction</th>
          <th>Avg (s)</th>
          <th>Min (s)</th>
          <th>P{{ lr_percentile }} (s)</th>
          <th>P99 (s)</th>
          <th>Max (s)</th>
          <th>Passed</th>
          <th>Failed</th>
          <th>TPS</th>
          <th>SLA</th>
        </tr>
      </thead>
      <tbody>
        {% for r in lr_rows %}
        <tr>
          <td><strong>{{ r.transaction }}</strong></td>
          <td>{{ r.avg if r.avg is not none else "—" }}</td>
          <td>{{ r.min if r.min is not none else "—" }}</td>
          <td>{{ r["p" ~ lr_percentile] if r["p" ~ lr_percentile] is not none else (r.p90 if r.p90 is not none else "—") }}</td>
          <td>{{ r.p99 if r.p99 is not none else "—" }}</td>
          <td>{{ r.max if r.max is not none else "—" }}</td>
          <td>{{ r.passed if r.passed is not none else "—" }}</td>
          <td>{{ r.failed if r.failed is not none else "—" }}</td>
          <td>{{ r.tps if r.tps is not none else "—" }}</td>
          <td><span class="badge {{ r.sev }}">{{ r.sev | upper }}</span></td>
        </tr>
        {% endfor %}
        <tr>
          <td colspan="10" style="font-size:11px;color:var(--muted);font-style:italic;padding:8px 12px">
            ↑ All transactions from the loaded LR file(s) are shown above
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
{% endif %}

<hr class="divider">

<!-- ══ SERVER UTILIZATION ══ -->
{% if server_stats %}
<div class="section">
  <div class="section-title amber">③ Server resource utilization</div>

  {% set app_servers = server_stats | selectattr("source", "ne", "SQL") | list %}
  {% set db_servers  = server_stats | selectattr("source", "eq", "SQL") | list %}

  {% if app_servers | length >= 2 %}
  <div class="two-col">
    {% for s in app_servers %}
    <div class="server-block">
      <div class="server-header">
        <div class="server-name">
          &#9635; {{ s.name }}
          {% for t in s.tags %}<span class="tag">{{ t }}</span>{% endfor %}
        </div>
        <div class="status-row">
          {% if s.sev_counts.crit > 0 %}
            <span class="badge crit">{{ s.sev_counts.crit }} critical</span>
          {% endif %}
          {% if s.sev_counts.warn > 0 %}
            <span class="badge warn">{{ s.sev_counts.warn }} warning</span>
          {% endif %}
          {% if s.sev_counts.crit == 0 and s.sev_counts.warn == 0 %}
            <span class="badge ok">healthy</span>
          {% endif %}
        </div>
      </div>

      {% for section in s.sections %}
        <p class="server-section-title">{{ section.title }}</p>
        {% if section.metrics %}
        <div class="metric-grid">
          {% for m in section.metrics %}
          <div class="m-card">
            <div class="lbl">{{ m.label }}</div>
            <div class="val {{ m.sev }}">{{ m.value }}</div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% if section.bars %}
        <div style="margin-top:8px">
          {% for b in section.bars %}
          <div class="bar-row">
            <span class="bar-label">{{ b.label }}</span>
            <div class="bar-track">
              <div class="bar-fill {{ b.sev }}" style="width:{{ [b.pct, 100] | min }}%"></div>
            </div>
            <span class="bar-val">{{ b.val }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% if section.table %}
        <div class="table-wrap" style="margin-top:10px">
          {% if section.table.caption %}<p style="font-size:10px;color:#6B7280;margin:0 0 4px 0">{{ section.table.caption }}</p>{% endif %}
          <table class="data-table" style="font-size:11px">
            <thead><tr>{% for h in section.table.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>
              {% for row in section.table.rows %}
              <tr class="{{ row.sev }}">{% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}</tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        {% if not loop.last %}<hr class="server-divider">{% endif %}
      {% endfor %}

      {{ render_findings(s.findings) }}
    </div>
    {% endfor %}
  </div>
  {% else %}
  {% for s in app_servers %}
  <div class="server-block">
    <div class="server-header">
      <div class="server-name">&#9635; {{ s.name }}
        {% for t in s.tags %}<span class="tag">{{ t }}</span>{% endfor %}
      </div>
      <div class="status-row">
        {% if s.sev_counts.crit > 0 %}<span class="badge crit">{{ s.sev_counts.crit }} critical</span>{% endif %}
        {% if s.sev_counts.warn > 0 %}<span class="badge warn">{{ s.sev_counts.warn }} warning</span>{% endif %}
        {% if s.sev_counts.crit == 0 and s.sev_counts.warn == 0 %}<span class="badge ok">healthy</span>{% endif %}
      </div>
    </div>
    {% for section in s.sections %}
      <p class="server-section-title">{{ section.title }}</p>
      {% if section.metrics %}
      <div class="metric-grid">
        {% for m in section.metrics %}
        <div class="m-card"><div class="lbl">{{ m.label }}</div><div class="val {{ m.sev }}">{{ m.value }}</div></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if section.bars %}
      <div style="margin-top:8px">
        {% for b in section.bars %}
        <div class="bar-row">
          <span class="bar-label">{{ b.label }}</span>
          <div class="bar-track"><div class="bar-fill {{ b.sev }}" style="width:{{ [b.pct, 100] | min }}%"></div></div>
          <span class="bar-val">{{ b.val }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if section.table %}
      <div class="table-wrap" style="margin-top:10px">
        {% if section.table.caption %}<p style="font-size:10px;color:#6B7280;margin:0 0 4px 0">{{ section.table.caption }}</p>{% endif %}
        <table class="data-table" style="font-size:11px">
          <thead><tr>{% for h in section.table.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in section.table.rows %}
            <tr class="{{ row.sev }}">{% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
      {% if not loop.last %}<hr class="server-divider">{% endif %}
    {% endfor %}
    {{ render_findings(s.findings) }}
  </div>
  {% endfor %}
  {% endif %}

  {% for s in db_servers %}
  <div class="server-block">
    <div class="server-header">
      <div class="server-name">&#9650; {{ s.name }}
        {% for t in s.tags %}<span class="tag">{{ t }}</span>{% endfor %}
      </div>
      <div class="status-row">
        {% if s.sev_counts.crit > 0 %}<span class="badge crit">{{ s.sev_counts.crit }} critical</span>{% endif %}
        {% if s.sev_counts.warn > 0 %}<span class="badge warn">{{ s.sev_counts.warn }} warning</span>{% endif %}
        {% if s.sev_counts.crit == 0 and s.sev_counts.warn == 0 %}<span class="badge ok">healthy</span>{% endif %}
      </div>
    </div>
    {% for section in s.sections %}
      <p class="server-section-title">{{ section.title }}</p>
      {% if section.metrics %}
      <div class="metric-grid">
        {% for m in section.metrics %}
        <div class="m-card"><div class="lbl">{{ m.label }}</div><div class="val {{ m.sev }}">{{ m.value }}</div></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if section.bars %}
      <div style="margin-top:8px">
        {% for b in section.bars %}
        <div class="bar-row">
          <span class="bar-label">{{ b.label }}</span>
          <div class="bar-track"><div class="bar-fill {{ b.sev }}" style="width:{{ [b.pct, 100] | min }}%"></div></div>
          <span class="bar-val">{{ b.val }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if section.table %}
      <div class="table-wrap" style="margin-top:10px">
        {% if section.table.caption %}<p style="font-size:10px;color:#6B7280;margin:0 0 4px 0">{{ section.table.caption }}</p>{% endif %}
        <table class="data-table" style="font-size:11px">
          <thead><tr>{% for h in section.table.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in section.table.rows %}
            <tr class="{{ row.sev }}">{% for cell in row.cells %}<td>{{ cell }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
      {% if not loop.last %}<hr class="server-divider">{% endif %}
    {% endfor %}
    {{ render_findings(s.findings) }}
  </div>
  {% endfor %}

</div>
{% endif %}

<hr class="divider">

<!-- ══ ANOMALY & TREND FINDINGS ══ -->
{% if raw_findings.threshold or raw_findings.trend %}
<div class="section">
  <div class="section-title teal">④ Anomaly &amp; trend findings</div>

  {% if raw_findings.threshold %}
  <p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px">SLA &amp; threshold breaches</p>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr><th>Metric</th><th>Actual</th><th>Threshold</th><th>Breaches</th><th>Severity</th></tr>
      </thead>
      <tbody>
        {% for f in raw_findings.threshold %}
        <tr>
          <td>{{ f.metric_name }}</td>
          <td><strong>{{ f.actual_value }}</strong></td>
          <td>{{ f.threshold_value }}</td>
          <td>{{ f.breach_count }}</td>
          <td><span class="badge {{ f.severity }}">{{ f.severity | upper }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if raw_findings.trend %}
  <p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:6px;margin-top:14px">Degradation trends</p>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr><th>Metric</th><th>Direction</th><th>Slope/min</th><th>R²</th><th>Severity</th><th>Description</th></tr>
      </thead>
      <tbody>
        {% for f in raw_findings.trend %}
        <tr>
          <td>{{ f.metric_name }}</td>
          <td>{{ f.direction }}</td>
          <td>{{ f.slope_per_min }}</td>
          <td>{{ f.r_squared }}</td>
          <td><span class="badge {{ f.severity }}">{{ f.severity | upper }}</span></td>
          <td style="color:#6b7280">{{ f.description }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>
{% endif %}

<!-- ══ CORRELATION TIMELINE ══ -->
{% if timeline.events %}
<div class="section">
  <div class="section-title teal">⑤ Event correlation timeline</div>
  <div style="border:1px solid #e5e7eb;border-radius:8px;padding:14px 16px">
    {% for e in timeline.events[:25] %}
    <div class="tl-item">
      <div class="tl-dot {{ e.severity }}"></div>
      <div class="tl-ts">{{ e.timestamp[:19] if e.timestamp else "—" }}</div>
      <div class="tl-desc">
        <span class="tl-src">{{ e.source }}</span>
        <strong>{{ e.metric_name }}</strong>
        {% if e.description %} — {{ e.description[:120] }}{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<hr class="divider">

<!-- ══ RCA ══ -->
<div class="section">
  <div class="section-title red">⑥ RCA</div>

  {% if summary %}
  <div class="summary-box">{{ summary }}</div>
  {% endif %}

  {% if leading_indicator %}
  <p style="font-size:12px;color:#374151;margin-bottom:14px">
    <strong>Leading indicator:</strong>
    <span style="color:#991b1b">{{ leading_indicator.metric_name }}</span>
    &nbsp;—&nbsp; {{ leading_indicator.source }}
    &nbsp;|&nbsp; first seen: {{ leading_indicator.timestamp }}
  </p>
  {% endif %}

  {% if cause_effect_chain %}
  <p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:8px">Cause → effect chain</p>
  <ol class="chain" style="margin-bottom:16px">
    {% for step in cause_effect_chain %}
    <li>
      <div class="chain-num">{{ loop.index }}</div>
      <div class="chain-txt">{{ step }}</div>
    </li>
    {% endfor %}
  </ol>
  {% endif %}

  {% if scored_hypotheses %}
  <p style="font-size:11px;font-weight:600;color:#374151;margin-bottom:10px">Ranked hypotheses</p>
  {% for h in scored_hypotheses %}
  <div class="hyp-card r{{ [loop.index, 3] | min }}">
    <div class="hyp-header">
      <div class="hyp-rank">{{ loop.index }}</div>
      <div class="hyp-text">{{ h.hypothesis }}</div>
      <span class="conf-badge conf-{{ h.confidence }}">{{ h.confidence }}</span>
    </div>
    <div class="hyp-evidence">
      <strong>Evidence:</strong> {{ h.evidence }}
      {% if h.sources_cited %}&nbsp;|&nbsp; <strong>Sources:</strong> {{ h.sources_cited | join(", ") }}{% endif %}
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:12px 16px;color:#6b7280;font-size:12px">
    No AI hypotheses available. Configure <code>OPENAI_API_KEY</code> in your .env file to enable causal analysis.
  </div>
  {% endif %}

  {% if raw_findings.pattern %}
  <p style="font-size:11px;font-weight:600;color:#374151;margin:16px 0 8px">Log patterns detected</p>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr><th>Pattern</th><th>Count</th><th>Severity</th><th>Method</th><th>Description</th></tr>
      </thead>
      <tbody>
        {% for f in raw_findings.pattern %}
        <tr>
          <td>{{ f.pattern_name }}</td>
          <td>{{ f.count }}</td>
          <td><span class="badge {{ f.severity }}">{{ f.severity | upper }}</span></td>
          <td>{{ f.method }}</td>
          <td style="color:#6b7280">{{ f.description }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>

<!-- ══ FOOTER ══ -->
<div class="footer">
  Generated by AI-Driven PT Log Mining Pipeline &nbsp;·&nbsp;
  {{ company_name }} &nbsp;·&nbsp; {{ generated_at }}
</div>

</div><!-- end .page -->
</body>
</html>
